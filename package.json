{
  "name": "mukeja-makhana-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "server": "npm run dev -w server",
    "client": "npm run dev -w client",
    "dev": "node -e \"console.log('\\n👉 Frontend and Backend processes are divided. Please run them in separate terminals:\\n   • Backend:  npm run dev:server\\n   • Frontend: npm run dev:client\\n')\"",
    "start": "npm run start -w server",
    "build": "npm run build -w client",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "setup:database": "npm run setup:db -w server",
    "backup:database": "npm run backup -w server"
  }
}
