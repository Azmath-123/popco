{
  "name": "mukeja-makhana-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "npm run start -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "node scripts/dev-client.js",
    "build": "npm run build -w client",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "setup:database": "node scripts/setup-db.js",
    "backup:database": "node scripts/backup.js"
  }
}
