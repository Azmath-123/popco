# API
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# PostgreSQL: point this at a database created for this application
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/mukeja_dev
DATABASE_SSL=false
DB_POOL_SIZE=10

# Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=mukeja_session
SESSION_TTL=8h

# Optional first administrator (created on first startup when both are set)
ADMIN_NAME=Store Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Optional payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
SUPPORT_EMAIL=Support@thepopcoindia.com
